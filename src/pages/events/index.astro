---
import { getCollection } from "astro:content"
import EventsListPage from "../../layouts/EventsListPage.astro"
import { groupByDate, upcomingEvents } from "../../utils/events"

const groupedEvents = groupByDate(upcomingEvents(await getCollection("events")))
---

<EventsListPage
  tab="upcoming"
  heading="Upcoming Events"
  groupedEvents={groupedEvents}
  searchIndexUrl="/events/search-index.json"
  noEventsText="No upcoming events found."
/>
