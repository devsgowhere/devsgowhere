---
import { getEvents } from "../../utils/getEvents"
import { render } from "astro:content";
import OrgPage from "../../layouts/OrgPage.astro";
import { type CollectionEntry, getCollection } from "astro:content";
import { pastEvents, upcomingEvents } from "../../utils/events";
export async function getStaticPaths() {
  const orgs = await getCollection("orgs");

  return orgs.map((org) => ({
    params: { slug: org.id },
    props: org,
  }));
}
type Props = CollectionEntry<"orgs">;

const org = Astro.props;

const events = (await getEvents())
  .filter((event) => org.id === event.data.org.id);

// Partition events to show past and future events separately
const orgPastEvents = pastEvents(events);
const orgUpcomingEvents = upcomingEvents(events);

const { Content } = await render(org);
---

<OrgPage {...org.data} pastEvents={orgPastEvents} upcomingEvents={orgUpcomingEvents}>
  <Content />
</OrgPage>
