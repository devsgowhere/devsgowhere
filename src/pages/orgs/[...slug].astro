---
import { getEvents } from "../../utils/getEvents"
import { render } from "astro:content";
import OrgPage from "../../layouts/OrgPage.astro";
import { type CollectionEntry, getCollection } from "astro:content";
import { pastEvents, startOfToday, upcomingEvents } from "../../utils/events";
export async function getStaticPaths() {
  const orgs = await getCollection("orgs");

  return orgs.map((org) => ({
    params: { slug: org.id },
    props: org,
  }));
}
type Props = CollectionEntry<"orgs">;

const org = Astro.props;

const events = (await getEvents())
  .filter((event) => org.id === event.data.org.id);

// Share the listings' Singapore day boundary, captured once for both partitions.
const today = startOfToday();
const past = pastEvents(events, today);
const upcoming = upcomingEvents(events, today);


const { Content } = await render(org);
---

<OrgPage {...org.data} pastEvents={past} upcomingEvents={upcoming}>
  <Content />
</OrgPage>
