---
import { getEvents } from "../utils/getEvents"
import { toSlug } from "../utils/helpers";

const { currentTag = "" } = Astro.props;
//Get ALL events (past and future)
const eventsAll = (await getEvents())
//Extract all unique tags from ALL events
// Get all tags with their counts, filter out tags with count < 5, and sort alphabetically
const allTags = eventsAll.flatMap(event => (event.data.tags ?? []));  
const normalisedTags = allTags.map(tag => tag.toLowerCase());
const tagCounts = normalisedTags.reduce((output: Record<string, number>, tag) => {
  if(!output[tag]){
    output[tag] = 0;
  }
  output[tag] += 1;
  return output;
}, {});

const uniqueTags = Object.keys(tagCounts);

const filteredTags = uniqueTags
  .filter(tag => tag.length <= 20)
  //.filter(tag => tagCounts[tag] >= 2)
  .sort((a, b) => tagCounts[b] - tagCounts[a]);
  const top20Tags = filteredTags.slice(0, 20).sort();
  const currentEventTags = eventsAll.flatMap(event => (event.data.tags ?? []));
  const normalisedCurrentEventTags = currentEventTags.map(tag => tag.toLowerCase());
  //const mergedTags = Array.from(new Set([...top20Tags, ...normalisedCurrentEventTags])).sort();
  const mergedTags = Array.from(new Set([...top20Tags, ...uniqueTags])).sort();
---

<aside class="tags-panel" aria-label="Event topics" data-current-tag={currentTag}>
  <h2 class="tags-header">Tags</h2>
  <details open>
    <summary class="tags-toggle">Tags</summary>
    <ul class="tags-list">
    {mergedTags.filter(tag => toSlug(tag)).map(tag => (
        <li>
          <a
            href={`/events/tag/${toSlug(tag)}/`}
            class:list={["tag-item", { selected: toSlug(tag) === currentTag }]}
            data-tag={tag}
            aria-current={toSlug(tag) === currentTag ? "page" : undefined}
          >#{tag}</a>
        </li>
    ))}
    </ul>
  </details>
  <!-- Close the mobile disclosure while parsing, before the deferred scripts can move the event list. -->
  <script is:inline>
    {
      const panel = document.currentScript.previousElementSibling
      if (panel instanceof HTMLDetailsElement && window.matchMedia("(max-width: 800px)").matches) panel.open = false
    }
  </script>
</aside>

<script>
  document.querySelectorAll<HTMLDetailsElement>(".tags-panel details").forEach((panel) => {
    const summary = panel.querySelector("summary")!
    const mobile = window.matchMedia("(max-width: 800px)")

    const syncViewport = () => {
      const focused = document.activeElement
      const hadFocus = panel.contains(focused)
      panel.open = !mobile.matches
      if (mobile.matches && hadFocus) summary.focus()
      else if (focused === summary) panel.querySelector("a")?.focus()
    }
    syncViewport()
    mobile.addEventListener("change", syncViewport)

    panel.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && mobile.matches && panel.open) {
        event.preventDefault()
        panel.open = false
        summary.focus()
      }
    })
  })
</script>

<style lang="scss">
  .tags-panel {
    min-width: 180px;
    max-width: 220px;
    border-radius: 10px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    padding: 1.5rem 1rem;
    margin-right: 2rem;
    max-height: 80vh;    
    overflow-y: auto;
    position: sticky;
    top: 2rem;
  }

  .tags-toggle {
    display: none;
    cursor: pointer;
    padding: 0.6rem 0.8rem;
    font-weight: bold;
    color: #444;
  }

  // Closed panels need a control without scripts; retain focus until the viewport handler transfers it.
  details:not([open]) > .tags-toggle,
  .tags-toggle:focus {
    display: list-item;
  }

  @media (max-width: 800px) {
    .tags-panel {
      position: static;
      width: 100%;
      max-height: none;
      min-width: 0;
      max-width: none;
      margin-right: 0;
      margin-bottom: 1rem;
      padding: 0.5rem 1rem;
    }
    .tags-header {
      display: none;
    }
    .tags-toggle {
      display: list-item;
    }
    .tags-list {
      max-height: 50vh;
      overflow-y: auto;
    }
  }
  .tags-header {
    font-size: 1.2rem;
    font-weight: bold;
    margin-bottom: 1rem;
    color: #444;
    text-align: left;
    /* Align with tags-list */
    padding-left: 0.8rem; // matches .tag-item horizontal padding
  }
  .tags-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .tag-item {
    display: block;
    width: 100%;
    border-radius: 5px;
    padding: 0.4rem 0.8rem;
    color: #2d3748;
    font-size: 1rem;
    cursor: pointer;
    transition: background 0.2s;
    text-decoration: none;
    border: none;
    &:hover, &:focus {
      background: #e3d6ef;
      color: var(--text-accent-color);
    }
  }
    .tag-item.selected {
    max-width: 100%;
    background: #e3d6ef;
    color: var(--text-accent-color);
  }
</style>
