# Copy to .env (gitignored). Read by `npm run create-event` and `npm run discover-events`.

# Meetup API, JWT flow (https://www.meetup.com/api/authentication/#p04-jwt-flow-section).
# Set all four or none; without them Meetup pages are scraped instead.
# The OAuth client's key (shown as the client ID)
MEETUP_CLIENT_ID=
# ID of the signing key created on the OAuth client's page
MEETUP_SIGNING_KEY_ID=
# The signing key's RSA private key (PEM); on one line, write newlines as \n
MEETUP_PRIVATE_KEY=
# Your Meetup member ID (must be the member who owns the OAuth client)
MEETUP_MEMBER_ID=
